<Window x:Class="StoreManagement.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:StoreManagement.Views"
        xmlns:viewmodels="clr-namespace:StoreManagement.ViewModels"
        Title="Store Management &amp; TPS" Height="768" Width="1024"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">
    <Window.DataContext>
        <viewmodels:MainViewModel/>
    </Window.DataContext>
    
    <Window.Resources>
        <DataTemplate DataType="{x:Type viewmodels:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:InventoryViewModel}">
            <views:InventoryView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:PosViewModel}">
            <views:PosView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewmodels:HistoryViewModel}">
            <views:HistoryView/>
        </DataTemplate>
        
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F4FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="0,0,1,0">
            <StackPanel Margin="20">
                <!-- Fingoals style logo/header -->
                <StackPanel Orientation="Horizontal" Margin="0,20,0,40">
                    <Border Background="#0D6EFD" CornerRadius="8" Width="30" Height="30" Margin="0,0,10,0">
                        <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="StoreManager" FontSize="20" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                </StackPanel>
                
                <TextBlock Text="MAIN MENU" Foreground="#AAA" FontSize="12" FontWeight="Bold" Margin="10,0,0,10"/>
                
                <Button Content="Dashboard" Command="{Binding ShowDashboardCommand}" 
                        Background="Transparent" Foreground="#333" FontSize="15" FontWeight="SemiBold" Padding="15" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
                
                <Button Content="POS Terminal" Command="{Binding ShowPosCommand}" 
                        Background="Transparent" Foreground="#333" FontSize="15" FontWeight="SemiBold" Padding="15" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
                
                <Button Content="Inventory Control" Command="{Binding ShowInventoryCommand}" 
                        Background="Transparent" Foreground="#333" FontSize="15" FontWeight="SemiBold" Padding="15" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
                
                <Button Content="Transaction History" Command="{Binding ShowHistoryCommand}" 
                        Background="Transparent" Foreground="#333" FontSize="15" FontWeight="SemiBold" Padding="15" Margin="0,5" BorderThickness="0" HorizontalContentAlignment="Left" Cursor="Hand"/>
            </StackPanel>
        </Border>

        <!-- Main Content -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentViewModel}"/>
    </Grid>
</Window>
