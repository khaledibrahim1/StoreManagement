<UserControl x:Class="StoreManagement.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StoreManagement.Views"
             Background="#F5F6FA">
    <UserControl.Resources>
        <local:NullToVisibilityConverter x:Key="NullToVisibilityConverter"/>

        <!-- Light DataGrid Style for Left Panel (Transactions History) -->
        <Style x:Key="HistoryDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F8F9FA"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#777777"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="12"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#E0E0E0"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="#333333"/>
                        <Setter Property="Padding" Value="10"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#EBF3FF"/>
                                <Setter Property="Foreground" Value="#0D6EFD"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#F5F6FA"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="10,12"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Dark DataGrid Style for Right Panel (Receipt Details) -->
        <Style x:Key="DetailsDataGridStyle" TargetType="DataGrid">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="RowBackground" Value="Transparent"/>
            <Setter Property="AlternatingRowBackground" Value="Transparent"/>
            <Setter Property="ColumnHeaderStyle">
                <Setter.Value>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="#888888"/>
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="FontSize" Value="11"/>
                        <Setter Property="Padding" Value="0,8"/>
                        <Setter Property="BorderThickness" Value="0,0,0,1"/>
                        <Setter Property="BorderBrush" Value="#2D323E"/>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="RowStyle">
                <Setter.Value>
                    <Style TargetType="DataGridRow">
                        <Setter Property="Foreground" Value="White"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#252A34"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Setter Property="Padding" Value="0,10"/>
                        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="DataGridCell">
                                    <Border Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}">
                                        <ContentPresenter VerticalAlignment="Center"/>
                                    </Border>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.5*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Transactions List -->
        <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Transaction History" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}" 
                          Style="{StaticResource HistoryDataGridStyle}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Trans ID" Binding="{Binding Id}" Width="80"/>
                        <DataGridTextColumn Header="Date" Binding="{Binding Date, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" Width="150"/>
                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat=C}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Transaction Details Panel -->
        <Border Grid.Column="1" Background="#1A1D24" CornerRadius="15" BorderBrush="#2D323E" BorderThickness="1" Padding="20">
            <Grid>
                <!-- Switch views based on whether a transaction is selected -->
                <Grid Visibility="{Binding SelectedTransaction, Converter={StaticResource NullToVisibilityConverter}}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/> <!-- Title & Badge -->
                        <RowDefinition Height="Auto"/> <!-- Date & Time Info -->
                        <RowDefinition Height="*"/>    <!-- Items DataGrid -->
                        <RowDefinition Height="Auto"/> <!-- Financial Summary -->
                    </Grid.RowDefinitions>

                    <!-- Receipt Header -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        
                        <StackPanel>
                            <TextBlock Text="INVOICE RECEIPT" FontSize="11" FontWeight="Bold" Foreground="#888888"/>
                            <TextBlock Text="{Binding SelectedTransaction.Id, StringFormat='Transaction #{0}'}" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,4,0,0"/>
                        </StackPanel>
                        
                        <!-- Status / Successful Badge -->
                        <Border Grid.Column="1" Background="#E6F4EA" CornerRadius="6" Padding="8,4" VerticalAlignment="Center">
                            <TextBlock Text="PAID" Foreground="#137333" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </Grid>

                    <!-- Date and Metadata Header -->
                    <Border Grid.Row="1" BorderThickness="0,0,0,1" BorderBrush="#2D323E" Margin="0,0,0,15">
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- Date info -->
                            <TextBlock Text="{Binding SelectedTransaction.Date, StringFormat='{}{0:yyyy-MM-dd   HH:mm}'}" Foreground="#AAAAAA" FontSize="12"/>
                            
                            <!-- Payment Method / Clerk or system reference -->
                            <TextBlock Grid.Column="1" Text="System Clerk" Foreground="#888888" FontSize="12" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Items DataGrid -->
                    <DataGrid Grid.Row="2" ItemsSource="{Binding SelectedTransactionItems}" Style="{StaticResource DetailsDataGridStyle}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*"/>
                            <DataGridTextColumn Header="Qty" Binding="{Binding Quantity}" Width="50"/>
                            <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Financial Summary -->
                    <Border Grid.Row="3" Background="#252A34" CornerRadius="10" Padding="15" Margin="0,15,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Subtotal" Foreground="#888888" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedTransaction.Subtotal, StringFormat=C}" Foreground="White" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <TextBlock Text="Tax (15%)" Foreground="#888888" FontSize="13"/>
                                <TextBlock Text="{Binding SelectedTransaction.Tax, StringFormat=C}" Foreground="White" FontSize="13" HorizontalAlignment="Right"/>
                            </Grid>
                            
                            <!-- Dotted Divider -->
                            <Border BorderThickness="0,1,0,0" BorderBrush="#3D4454" Margin="0,5,0,10"/>
                            
                            <Grid>
                                <TextBlock Text="Total Paid" Foreground="White" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding SelectedTransaction.Total, StringFormat=C}" Foreground="#0D6EFD" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- Empty State (Shown when SelectedTransaction is null) -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding SelectedTransaction}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <!-- Stylized Receipt Icon -->
                        <Border Background="#252A34" CornerRadius="20" Width="60" Height="60" Margin="0,0,0,15" HorizontalAlignment="Center">
                            <TextBlock Text="📄" FontSize="28" Foreground="#888888" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Text="No Transaction Selected" Foreground="White" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                        <TextBlock Text="Select a transaction from the list to view its complete receipt and itemized breakdown." Foreground="#777777" FontSize="13" TextWrapping="Wrap" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="250"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
