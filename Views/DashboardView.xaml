<UserControl x:Class="StoreManagement.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Financial Overview" FontSize="24" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>

        <Grid Grid.Row="1" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Revenue Card (Black Fingoals style) -->
            <Border Background="#111" CornerRadius="15" Padding="20" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="Total Revenue" Foreground="#AAA" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TotalRevenue, StringFormat=C}" Foreground="White" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Total Transactions Card -->
            <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20" Margin="10,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Total Transactions" Foreground="#777" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TotalTransactions}" Foreground="#0D6EFD" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <!-- Total Products Card -->
            <Border Grid.Column="2" Background="White" CornerRadius="15" Padding="20" Margin="10,0,0,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Products in Stock" Foreground="#777" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Text="{Binding TotalProducts}" Foreground="#333" FontSize="28" FontWeight="Bold"/>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="1.5*"/>
            </Grid.ColumnDefinitions>
            
            <!-- Income Sources Bar Chart -->
            <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,10,0">
                <Border.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
                </Border.Effect>
                <StackPanel>
                    <TextBlock Text="Recent Revenue" FontSize="18" FontWeight="Bold" Foreground="#333" Margin="0,0,0,20"/>
                    
                    <ItemsControl ItemsSource="{Binding DailySales}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="180" VerticalAlignment="Bottom"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Bottom" Margin="10,0">
                                    <Border Background="#0D6EFD" Width="30" Height="{Binding Height}" CornerRadius="4,4,0,0"/>
                                    <TextBlock Text="{Binding Date}" Foreground="#777" FontSize="10" HorizontalAlignment="Center" Margin="0,5,0,0"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Welcome Banner -->
            <Border Grid.Column="1" Background="#0D6EFD" CornerRadius="15" Padding="30" Margin="10,0,0,0" VerticalAlignment="Top">
                <StackPanel>
                    <TextBlock Text="Join Our Financial Class Mastery" Foreground="White" FontSize="22" FontWeight="Bold" Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <TextBlock Text="Welcome back to the dashboard. You can access POS, Inventory, and History from the sidebar." Foreground="#E0E0E0" FontSize="14" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
