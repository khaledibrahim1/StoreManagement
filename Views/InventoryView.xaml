<UserControl x:Class="StoreManagement.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:StoreManagement.Views"
             Background="#F5F6FA">
    <UserControl.Resources>
        <local:LowStockBgConverter x:Key="LowStockBgConverter"/>
        <local:LowStockTextConverter x:Key="LowStockTextConverter"/>
        
        <!-- Base styling for Button -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    
    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Inventory List Card -->
        <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Inventory Items" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                <DataGrid Grid.Row="1" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                          AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                          BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="SKU" Binding="{Binding SKU}" Width="100"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding Price, StringFormat=C}" Width="100"/>
                        <DataGridTextColumn Header="Stock" Binding="{Binding StockQuantity}" Width="80"/>
                        <DataGridTemplateColumn Header="Status" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="5" Padding="5,2" Margin="5"
                                            Background="{Binding IsLowStock, Converter={StaticResource LowStockBgConverter}}">
                                        <TextBlock Text="{Binding IsLowStock, Converter={StaticResource LowStockTextConverter}}" 
                                                   Foreground="White" FontSize="10" HorizontalAlignment="Center"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- Form Card Fingoals style (Black card for contrast) -->
        <Border Grid.Column="1" Background="#111" CornerRadius="15" Padding="20">
            <StackPanel>
                <TextBlock Text="Product Details" FontSize="20" FontWeight="Bold" Foreground="White" Margin="0,0,0,20"/>
                
                <TextBlock Text="Name" Foreground="#AAA" Margin="0,5,0,2"/>
                <Border Background="#222" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White"/>
                </Border>

                <TextBlock Text="SKU" Foreground="#AAA" Margin="0,5,0,2"/>
                <Border Background="#222" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <TextBox Text="{Binding SKU, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White"/>
                </Border>

                <TextBlock Text="Price" Foreground="#AAA" Margin="0,5,0,2"/>
                <Border Background="#222" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <TextBox Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White"/>
                </Border>

                <TextBlock Text="Stock Quantity" Foreground="#AAA" Margin="0,5,0,2"/>
                <Border Background="#222" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                    <TextBox Text="{Binding StockQuantity, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="White" BorderThickness="0" CaretBrush="White"/>
                </Border>

                <TextBlock Text="Product Image" Foreground="#AAA" Margin="0,5,0,2"/>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Background="#222" Width="50" Height="50" CornerRadius="5" Margin="0,0,10,0">
                        <Image Source="{Binding AbsoluteImagePath}" Stretch="UniformToFill">
                            <Image.Clip>
                                <RectangleGeometry Rect="0,0,50,50" RadiusX="5" RadiusY="5"/>
                            </Image.Clip>
                        </Image>
                    </Border>
                    <Button Grid.Column="1" Content="Upload Image" Command="{Binding UploadImageCommand}" 
                            Background="#444" Foreground="White" FontWeight="Bold" Padding="10" Cursor="Hand" VerticalAlignment="Center">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}" CornerRadius="5">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </Grid>

                <Button Content="Add Product" Command="{Binding AddCommand}" 
                        Background="#0D6EFD" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,5" Cursor="Hand"/>
                <Button Content="Update Selected" Command="{Binding UpdateCommand}" 
                        Background="#444" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,5" Cursor="Hand"/>
                <Button Content="Delete Selected" Command="{Binding DeleteCommand}" 
                        Background="#DC3545" Foreground="White" FontWeight="Bold" Padding="10" Margin="0,5" Cursor="Hand"/>
                <Button Content="Clear Form" Command="{Binding ClearCommand}" 
                        Background="Transparent" Foreground="#AAA" FontWeight="Bold" Padding="10" Margin="0,5" Cursor="Hand"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
