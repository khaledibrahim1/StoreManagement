<Window x:Class="StoreManagement.Views.HomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:StoreManagement.ViewModels"
        Name="HomeWin"
        Title="Welcome to StoreManager" Height="600" Width="800"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA">
    
    <Window.DataContext>
        <viewmodels:HomeViewModel/>
    </Window.DataContext>

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border Background="#0D6EFD" CornerRadius="20" Width="80" Height="80" Margin="0,0,0,20">
                <TextBlock Text="S" Foreground="White" FontWeight="Bold" FontSize="50" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            
            <TextBlock Text="StoreManager" FontSize="40" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
            <TextBlock Text="The ultimate dual-purpose POS and Inventory system." FontSize="16" Foreground="#777" HorizontalAlignment="Center" Margin="0,0,0,40"/>
            
            <Button Content="Proceed to Login" 
                    Command="{Binding GoToLoginCommand}" CommandParameter="{Binding ElementName=HomeWin}"
                    Background="#0D6EFD" Foreground="White" FontWeight="Bold" FontSize="18" Padding="30,15" Cursor="Hand" HorizontalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="15">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Grid>
</Window>
