<Window x:Class="StoreManagement.Views.CheckoutPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="CheckoutWin"
        Title="Confirm Checkout" Height="300" Width="400"
        WindowStartupLocation="CenterOwner" Background="#F5F6FA"
        WindowStyle="ToolWindow" ResizeMode="NoResize">
    
    <Border Background="White" CornerRadius="15" Margin="20" Padding="20">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Confirm Transaction" FontSize="20" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <Grid Margin="0,0,0,5">
                <TextBlock Text="Subtotal:" Foreground="#777" FontSize="14"/>
                <TextBlock Text="{Binding TransactionData.Subtotal, StringFormat=C}" Foreground="#333" FontSize="14" HorizontalAlignment="Right"/>
            </Grid>
            <Grid Margin="0,0,0,15">
                <TextBlock Text="Tax (15%):" Foreground="#777" FontSize="14"/>
                <TextBlock Text="{Binding TransactionData.Tax, StringFormat=C}" Foreground="#333" FontSize="14" HorizontalAlignment="Right"/>
            </Grid>
            <Separator Margin="0,0,0,15"/>
            <Grid Margin="0,0,0,25">
                <TextBlock Text="Total Amount:" Foreground="#333" FontWeight="Bold" FontSize="16"/>
                <TextBlock Text="{Binding TransactionData.Total, StringFormat=C}" Foreground="#0D6EFD" FontWeight="Bold" FontSize="20" HorizontalAlignment="Right"/>
            </Grid>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Content="Cancel" Command="{Binding CancelCommand}" CommandParameter="{Binding ElementName=CheckoutWin}"
                        Background="#DC3545" Foreground="White" FontWeight="Bold" Padding="10" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                <Button Grid.Column="2" Content="Confirm Payment" Command="{Binding ConfirmCommand}" CommandParameter="{Binding ElementName=CheckoutWin}"
                        Background="#0D6EFD" Foreground="White" FontWeight="Bold" Padding="10" Cursor="Hand" BorderThickness="0">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="8">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>
        </StackPanel>
    </Border>
</Window>
