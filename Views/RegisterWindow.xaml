<Window x:Class="StoreManagement.Views.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:StoreManagement.ViewModels"
        Name="RegisterWin"
        Title="Sign Up - StoreManager" Height="520" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <viewmodels:RegisterViewModel/>
    </Window.DataContext>

    <Border Background="White" CornerRadius="15" Margin="30" Padding="25">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Create Account" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,15"/>
            
            <TextBlock Text="Username" Foreground="#777" Margin="0,0,0,5"/>
            <Border Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#333" FontSize="14"/>
            </Border>

            <TextBlock Text="Password" Foreground="#777" Margin="0,0,0,5"/>
            <Border Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,12">
                <PasswordBox Name="txtPassword" Background="Transparent" BorderThickness="0" Foreground="#333" FontSize="14"/>
            </Border>

            <TextBlock Text="Confirm Password" Foreground="#777" Margin="0,0,0,5"/>
            <Border Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <PasswordBox Name="txtConfirmPassword" Background="Transparent" BorderThickness="0" Foreground="#333" FontSize="14"/>
            </Border>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap"/>

            <Button Content="Sign Up" Command="{Binding RegisterCommand}" CommandParameter="{Binding ElementName=RegisterWin}"
                    Background="#0D6EFD" Foreground="White" FontWeight="Bold" FontSize="16" Padding="10" Cursor="Hand" Margin="0,0,0,10">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="Already have an account? Log In" Command="{Binding BackToLoginCommand}" CommandParameter="{Binding ElementName=RegisterWin}"
                    Background="Transparent" Foreground="#777" FontWeight="SemiBold" FontSize="13" BorderThickness="0" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" HorizontalAlignment="Center" VerticalAlignment="Center" TextDecorations="Underline"/>
                    </ControlTemplate>
                </Button.Template>
                <Button.Style>
                    <Style TargetType="Button">
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Foreground" Value="#0D6EFD"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Border>
</Window>
