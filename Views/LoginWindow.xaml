<Window x:Class="StoreManagement.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:StoreManagement.ViewModels"
        Title="Login - StoreManager" Height="450" Width="400"
        WindowStartupLocation="CenterScreen" Background="#F5F6FA"
        ResizeMode="NoResize">
    
    <Window.DataContext>
        <viewmodels:LoginViewModel/>
    </Window.DataContext>

    <Border Background="White" CornerRadius="15" Margin="40" Padding="30">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
        </Border.Effect>
        <StackPanel VerticalAlignment="Center">
            <TextBlock Text="Welcome Back" FontSize="24" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,20"/>
            
            <TextBlock Text="Username" Foreground="#777" Margin="0,0,0,5"/>
            <Border Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#333" FontSize="14"/>
            </Border>

            <TextBlock Text="Password" Foreground="#777" Margin="0,0,0,5"/>
            <Border Background="#F9F9F9" CornerRadius="8" Padding="10" Margin="0,0,0,10">
                <PasswordBox Name="txtPassword" Background="Transparent" BorderThickness="0" Foreground="#333" FontSize="14"/>
            </Border>
            
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#DC3545" FontSize="12" HorizontalAlignment="Center" Margin="0,0,0,15" Visibility="Visible"/>

            <Button Content="Login" Command="{Binding LoginCommand}" CommandParameter="{Binding ElementName=txtPassword}"
                    Background="#111" Foreground="White" FontWeight="Bold" FontSize="16" Padding="10" Cursor="Hand">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </StackPanel>
    </Border>
</Window>
