<UserControl x:Class="StoreManagement.Views.PosView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="#F5F6FA">
    <UserControl.Resources>
        <!-- Base styling for Button -->
        <Style TargetType="Button">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1.5*"/>
        </Grid.ColumnDefinitions>

        <!-- Product Search and List -->
        <Border Background="White" CornerRadius="15" Padding="20" Margin="0,0,20,0">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Terminal Sales" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                
                <Border Grid.Row="1" Background="#F0F0F0" CornerRadius="8" Padding="10" Margin="0,0,0,15">
                    <TextBox Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" BorderThickness="0" Foreground="#333" FontSize="14"/>
                </Border>
                
                <ListBox Grid.Row="2" ItemsSource="{Binding AvailableProducts}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F9F9F9" CornerRadius="8" Padding="15" Margin="0,0,0,10">
                                <Grid Width="400">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    
                                    <Border Width="40" Height="40" CornerRadius="5" Margin="0,0,15,0" Background="#EEE">
                                        <Image Source="{Binding AbsoluteImagePath}" Stretch="UniformToFill">
                                            <Image.Clip>
                                                <RectangleGeometry Rect="0,0,40,40" RadiusX="5" RadiusY="5"/>
                                            </Image.Clip>
                                        </Image>
                                    </Border>
                                    
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="16" Foreground="#333"/>
                                        <TextBlock Text="{Binding SKU, StringFormat='SKU: {0}'}" Foreground="#777" FontSize="12"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Margin="20,0">
                                        <TextBlock Text="{Binding Price, StringFormat=C}" FontWeight="Bold" Foreground="#0D6EFD" FontSize="14"/>
                                        <TextBlock Text="{Binding StockQuantity, StringFormat='Stock: {0}'}" Foreground="#777" FontSize="12"/>
                                    </StackPanel>
                                    <Button Grid.Column="3" Content="Add to Cart" Command="{Binding DataContext.AddToCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#0D6EFD" Foreground="White" Padding="10,5" Cursor="Hand"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Cart and Checkout -->
        <Border Grid.Column="1" Background="White" CornerRadius="15" Padding="20">
            <Border.Effect>
                <DropShadowEffect Color="Black" Opacity="0.05" BlurRadius="10" ShadowDepth="2"/>
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Text="Current Cart" FontSize="20" FontWeight="Bold" Foreground="#333" Margin="0,0,0,15"/>
                
                <DataGrid Grid.Row="1" ItemsSource="{Binding Cart}" AutoGenerateColumns="False" CanUserAddRows="False" 
                          Background="Transparent" RowBackground="White" AlternatingRowBackground="#F9F9F9"
                          BorderThickness="0" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#E0E0E0">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Item" Binding="{Binding Product.Name}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged}" Width="50"/>
                        <DataGridTextColumn Header="Price" Binding="{Binding TotalPrice, StringFormat=C}" Width="80" IsReadOnly="True"/>
                        <DataGridTemplateColumn Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Button Content="Remove" Command="{Binding DataContext.RemoveFromCartCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}" Background="#DC3545" Foreground="White" Padding="5,2" Cursor="Hand" Margin="2"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <StackPanel Grid.Row="2" Margin="0,20,0,0">
                    <Border Background="#F9F9F9" CornerRadius="10" Padding="15">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Subtotal:" Foreground="#777" FontSize="14"/>
                                <TextBlock Text="{Binding Subtotal, StringFormat=C}" FontWeight="Bold" Foreground="#333" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                            <Grid Margin="0,0,0,10">
                                <TextBlock Text="Tax (15%):" Foreground="#777" FontSize="14"/>
                                <TextBlock Text="{Binding Tax, StringFormat=C}" FontWeight="Bold" Foreground="#333" FontSize="14" HorizontalAlignment="Right"/>
                            </Grid>
                            <Separator Margin="0,5,0,15"/>
                            <Grid>
                                <TextBlock Text="Total:" Foreground="#333" FontWeight="Bold" FontSize="18"/>
                                <TextBlock Text="{Binding Total, StringFormat=C}" FontWeight="Bold" Foreground="#0D6EFD" FontSize="20" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Content="Checkout" Command="{Binding CheckoutCommand}" Background="#111" Foreground="White" FontWeight="Bold" FontSize="16" Padding="15" Margin="0,20,0,0" Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
